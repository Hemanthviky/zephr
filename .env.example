# Copy this file to `.env` and fill in the two values from your Supabase project:
#   Supabase Dashboard → Project Settings → API
#
# Both are safe to expose in a browser bundle *only because* Row Level Security
# is enabled on every table (see supabase/schema.sql). Never put the
# `service_role` key here — it bypasses RLS.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
